# MSSQL LocalDB connection example (uses the msnodesqlv8 driver - see backend/db.js)
DB_SERVER=(localdb)\MSSQLLocalDB
DB_DATABASE=BiblionDB
# Leave USER/PASS empty to use Windows Integrated Auth (Trusted_Connection)
DB_USER=
DB_PASS=
# Requiere "ODBC Driver 17 for SQL Server" instalado
ODBC_DRIVER=ODBC Driver 17 for SQL Server
JWT_SECRET=changeme
PORT=4000
# Cuenta admin creada sola en el primer arranque del servidor (opcional, tiene valores por defecto)
ADMIN_EMAIL=admin@biblion.local
ADMIN_PASSWORD=Admin123!
